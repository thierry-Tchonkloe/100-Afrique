# .env.test.example

# Base PostgreSQL dédiée UNIQUEMENT aux tests d'intégration.
DATABASE_URL="postgresql://postgres:root@localhost:5432/itourisme_nomade_test"

# Secret JWT utilisé uniquement pour signer les tokens pendant les tests.
JWT_SECRET=test-secret-not-for-production
JWT_EXPIRES_IN=7d

# Nombre de rounds bcrypt réduit (4 au lieu de 10)
BCRYPT_ROUNDS=4

NODE_ENV=test
